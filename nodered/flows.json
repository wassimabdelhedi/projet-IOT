    {
        "id": "check_threshold",
        "type": "function",
        "z": "tab_smart_energy",
        "name": "Vérif seuil + logique délestage",
        "func": "// ─── CONFIGURATION ────────────────────────────\nconst SEUIL_W      = 300;\nconst HYSTERESIS_W = 30;\n\nvar power   = msg.payload.power_W   || 0;\nvar current = msg.payload.current_A || 0;\nvar nodeId  = msg.payload.node_id   || 'unknown';\n\nvar relayOpen = flow.get('relay_open') || false;\n\nvar cmd = null;\nvar alert = null;\n\nif (power > SEUIL_W && !relayOpen) {\n    relayOpen = true;\n    flow.set('relay_open', true);\n    cmd   = '0';\n    alert = {\n        type    : 'SURCHARGE',\n        power_W : power,\n        seuil_W : SEUIL_W,\n        action  : 'Relais ouvert — charge coupée',\n        ts      : new Date().toISOString()\n    };\n    node.warn('ALERTE SURCHARGE : ' + power + 'W > ' + SEUIL_W + 'W');\n\n} else if (power < (SEUIL_W - HYSTERESIS_W) && relayOpen) {\n    relayOpen = false;\n    flow.set('relay_open', false);\n    cmd   = '1';\n    alert = {\n        type    : 'RETOUR_NORMAL',\n        power_W : power,\n        seuil_W : SEUIL_W,\n        action  : 'Relais fermé — charge rétablie',\n        ts      : new Date().toISOString()\n    };\n}\n\nmsg.payload.relay_open = relayOpen;\nmsg.payload.ts = new Date().toISOString();\n\nvar outCmd = null;\nvar outAlert = null;\n\nif (cmd !== null) {\n    outCmd   = { payload: cmd, topic: 'sem/bat1/node1/cmd/relay' };\n    outAlert = { payload: alert };\n}\n\nreturn [msg, outCmd, outAlert];",
        "outputs": 3,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 590,
        "y": 400,
        "wires": [
            [],
            [
                "mqtt_out_relay",
                "debug_relay"
            ],
            [
                "firebase_alerts",
                "format_alert_text",
                "debug_alert"
            ]
        ]
    },
    {
        "id": "format_alert_text",
        "type": "function",
        "z": "tab_smart_energy",
        "name": "Format alerte → texte UI",
        "func": "var a = msg.payload;\nif (!a) return null;\nvar icon = a.type === 'SURCHARGE' ? '🔴 SURCHARGE' : '🟢 RETOUR NORMAL';\nmsg.payload = icon + ' | ' + a.power_W.toFixed(1) + 'W | ' + a.action + ' | ' + new Date(a.ts).toLocaleTimeString();\nreturn msg;",
        "outputs": 1,
        "x": 850,
        "y": 740,
        "wires": [
            [
                "text_alert"
            ]
        ]
