    {
        "id": "check_threshold",
        "type": "function",
        "z": "tab_smart_energy",
        "name": "Vérif seuil + logique délestage",
        "func": "// ─── CONFIGURATION ────────────────────────────\nconst SEUIL_W      = 300;   // Seuil de délestage (Watts)\nconst HYSTERESIS_W = 30;    // Hystérésis pour éviter oscillation\n\n// ─── RÉCUPÉRATION DES DONNÉES ────────────────\nvar power   = msg.payload.power_W   || 0;\nvar current = msg.payload.current_A || 0;\nvar nodeId  = msg.payload.node_id   || 'unknown';\n\n// ─── ÉTAT PERSISTANT (contexte flow) ─────────\nvar relayOpen = flow.get('relay_open') || false;\n\n// ─── LOGIQUE DE DÉLESTAGE ────────────────────\nvar cmd = null;\nvar alert = null;\n\nif (power > SEUIL_W && !relayOpen) {\n    // Dépasse le seuil → ouvrir le relais\n    relayOpen = true;\n    flow.set('relay_open', true);\n    cmd   = '0';   // 0 = relais ouvert = charge coupée\n    alert = {\n        type    : 'SURCHARGE',\n        power_W : power,\n        seuil_W : SEUIL_W,\n        action  : 'Relais ouvert — charge coupée',\n        ts      : new Date().toISOString()\n    };\n    node.warn('ALERTE SURCHARGE : ' + power + 'W > ' + SEUIL_W + 'W');\n\n} else if (power < (SEUIL_W - HYSTERESIS_W) && relayOpen) {\n    // Retombe sous (seuil - hystérésis) → fermer le relais\n    relayOpen = false;\n    flow.set('relay_open', false);\n    cmd   = '1';   // 1 = relais fermé = charge alimentée\n    alert = {\n        type    : 'RETOUR_NORMAL',\n        power_W : power,\n        seuil_W : SEUIL_W,\n        action  : 'Relais fermé — charge rétablie',\n        ts      : new Date().toISOString()\n    };\n}\n\n// ─── ENRICHISSEMENT DU PAYLOAD ───────────────\nmsg.payload.relay_open = relayOpen;\nmsg.payload.ts = new Date().toISOString();\n\n// ─── MESSAGES DE SORTIE ──────────────────────\n// Sortie 0 : données enrichies (toujours)\n// Sortie 1 : commande relais (seulement si changement d'état)\n// Sortie 2 : alerte (seulement si changement d'état)\n\nvar outCmd = null;\nvar outAlert = null;\n\nif (cmd !== null) {\n    outCmd   = { payload: cmd, topic: 'sem/bat1/node1/cmd/relay' };\n    outAlert = { payload: alert };\n}\n\nreturn [msg, outCmd, outAlert];",
        "outputs": 3,
        "noerr": 0,
        "x": 610,
        "y": 160,
        "wires": [
            [
                "firebase_write"
            ],
            [
                "mqtt_out_relay",
                "debug_relay"
            ],
            [
                "firebase_alerts",
                "debug_alert"
            ]
        ]
    },
