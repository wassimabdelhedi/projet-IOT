    {
        "id": "firebase_write",
        "type": "function",
        "z": "tab_smart_energy",
        "name": "Prépare payload Firebase mesures",
        "func": "// Structure Firebase : /readings/{timestamp}\nvar ts = Date.now();\nmsg.url = 'https://smart-energy-iot-461ff-default-rtdb.firebaseio.com/readings/' + ts + '.json';\nmsg.method = 'PUT';\nmsg.headers = { 'Content-Type': 'application/json' };\nmsg.payload = {\n    node_id    : msg.payload.node_id   || 'esp32-energy-01',\n    current_A  : msg.payload.current_A || 0,\n    voltage_V  : msg.payload.voltage_V || 230,\n    power_W    : msg.payload.power_W   || 0,\n    relay_open : msg.payload.relay_open || false,\n    ts         : new Date(ts).toISOString()\n};\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 800,
        "y": 120,
        "wires": [
            [
                "http_firebase_readings"
            ]
        ]
    },
    {
        "id": "http_firebase_readings",
